# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# 只想跑演示、不想配模型和转写？不用这个文件，直接在命令行设 MIANYAN_DEMO_MODE=1：
# 服务会显式使用本地模拟的语言模型与转写，不联网、不需要任何密钥。
# MIANYAN_DEMO_MODE=1
#
# 语言模型：任何 OpenAI 兼容的 /chat/completions 服务（默认 LongCat）
MIANYAN_LLM_BASE_URL=https://api.longcat.chat/openai/v1
MIANYAN_LLM_API_KEY=
MIANYAN_LLM_MODEL=LongCat-2.5-Preview
MIANYAN_LLM_TIMEOUT_MS=90000

# 语音识别：默认走本机 sherpa-onnx + SenseVoice，音频不离开本机
MIANYAN_ASR_PROVIDER=local-sherpa
MIANYAN_ASR_SHERPA_BIN=C:\path\to\sherpa-onnx-offline.exe
MIANYAN_ASR_SHERPA_MODEL=C:\path\to\sensevoice\model.int8.onnx
MIANYAN_ASR_SHERPA_TOKENS=C:\path\to\sensevoice\tokens.txt
MIANYAN_ASR_LANGUAGE=zh
MIANYAN_ASR_THREADS=4
MIANYAN_FFMPEG_PATH=ffmpeg

# 如果改用远端 OpenAI 兼容转写服务，将 MIANYAN_ASR_PROVIDER 改为 openai-compatible
# 并填写下面三项（API Key 可留空，用于无需鉴权的本机服务）
# MIANYAN_ASR_PROVIDER=openai-compatible
# MIANYAN_ASR_BASE_URL=
# MIANYAN_ASR_API_KEY=
# MIANYAN_ASR_MODEL=

# HTTP
MIANYAN_HOST=127.0.0.1
MIANYAN_PORT=8787
MIANYAN_DB_PATH=./data/mianyan.db
MIANYAN_AUDIO_DIR=./data/audio
# 通过 HTTPS 提供服务时设为 1，登录 Cookie 会带上 Secure
MIANYAN_COOKIE_SECURE=0

# 留存：录音与转写 180 天后清理，同意记录保留 730 天
MIANYAN_AUDIO_RETENTION_DAYS=180
MIANYAN_CONSENT_RETENTION_DAYS=730
