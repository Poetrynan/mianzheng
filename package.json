{
  "name": "mianyan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "contrast": "node apps/web/scripts/contrast-check.mjs",
    "build": "vite build apps/web",
    "preview": "vite preview apps/web --port 4173",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch apps/server/src/main.ts",
    "dev:web": "vite apps/web",
    "seed": "tsx packages/core/src/scripts/seed.ts",
    "migrate:accounts": "tsx apps/server/src/scripts/attachAccounts.ts",
    "e2e": "tsx apps/server/src/scripts/closedLoop.ts",
    "verify:real": "tsx apps/server/src/scripts/realSmoke.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  }
}
